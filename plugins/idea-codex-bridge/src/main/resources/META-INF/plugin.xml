<idea-plugin>
    <id>com.codexbridge.idea</id>
    <name>Codex Bridge</name>
    <vendor>cuitianhao</vendor>
    <description><![CDATA[
        Codex Bridge IDEA plugin with in-IDE A/B bridge chat, Codex / Claude / Remote selection, and cross-device Remote/Hub workflows.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Codex Bridge" displayType="BALLOON"/>
        <toolWindow id="Codex Bridge"
                    anchor="left"
                    factoryClass="com.codexbridge.idea.CodexBridgeToolWindowFactory"
                    canCloseContents="false"/>
    </extensions>

    <actions>
        <action
                id="CodexBridge.OpenWithCurrentProject"
                class="com.codexbridge.idea.OpenCodexBridgeAction"
                text="Open Codex Bridge Tool Window"
                description="Open Codex Bridge tool window"/>

        <group id="CodexBridge.Group" text="Codex Bridge" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="CodexBridge.OpenWithCurrentProject.Ref"
                    class="com.codexbridge.idea.OpenCodexBridgeAction"
                    text="Open Tool Window"/>
        </group>
    </actions>
</idea-plugin>
