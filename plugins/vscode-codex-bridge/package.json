{
  "name": "codex-bridge-launcher",
  "displayName": "Codex Bridge",
  "description": "Requires pre-configured codex. Built for cross-project collaboration and joint debugging in VSCode with bridged A/B sessions.",
  "version": "0.1.1",
  "publisher": "tianhao",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexBridge.openWithCurrentProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexBridge.openWithCurrentProject",
        "title": "Codex Bridge: Open With Current Project"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
