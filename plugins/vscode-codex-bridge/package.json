{
  "name": "codex-bridge-launcher",
  "displayName": "Codex Bridge",
  "description": "Requires pre-configured codex. Built for cross-project collaboration and joint debugging in VSCode with bridged A/B sessions.",
  "version": "0.1.1",
  "publisher": "tianhao",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexBridge.openWithCurrentProject",
    "onView:codexBridge.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexBridgeSidebar",
          "title": "Codex Bridge",
          "icon": "media/bridge.svg"
        }
      ]
    },
    "views": {
      "codexBridgeSidebar": [
        {
          "id": "codexBridge.sidebar",
          "name": "Codex Bridge",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codexBridge.openWithCurrentProject",
        "title": "Codex Bridge: Focus Sidebar"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run build && node test/bridgeProtocol.test.js && node test/codexExecutable.test.js && node test/webviewSyntax.test.js && node test/remoteConfig.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
