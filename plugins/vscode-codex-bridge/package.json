{
  "name": "agent-bridge",
  "displayName": "Agent Bridge",
  "description": "Bridge Codex, Claude Code, and remote AI agents in one sidebar with A/B sessions, streaming relay, and cross-device conversations.",
  "version": "0.1.1",
  "publisher": "tianhao",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tianhaocui/codex-bridge.git"
  },
  "files": [
    "out/**/*.js",
    "media/**",
    "readme.md",
    "LICENSE.md",
    "package.json",
    "node_modules/ws/**"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexBridge.openWithCurrentProject",
    "onView:codexBridge.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexBridgeSidebar",
          "title": "Agent Bridge",
          "icon": "media/bridge.svg"
        }
      ]
    },
    "views": {
      "codexBridgeSidebar": [
        {
          "id": "codexBridge.sidebar",
          "name": "Agent Bridge",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codexBridge.openWithCurrentProject",
        "title": "Agent Bridge: Focus Sidebar"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run build && node test/bridgeProtocol.test.js && node test/codexExecutable.test.js && node test/claudeExecutable.test.js && node test/claudeWorker.test.js && node test/webviewSyntax.test.js && node test/claudeProjectOptions.test.js && node test/remoteConfig.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
